---
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="404 | Sam Riddle"
  description="The page you were looking for does not exist."
  canonicalUrl="https://samuelwriddle.com/404"
>
  <section
    class="flex min-h-[calc(100vh-10rem)] items-center px-4 py-20 text-center md:px-8"
  >
    <Container>
      <div class="fade-in mx-auto max-w-[34rem] delay-1">
        <h1
          class="text-primary m-0 mb-4 text-[clamp(2.25rem,7vw,4rem)] leading-[1.05] font-bold"
        >
          Page not found
        </h1>

        <p class="text-secondary mx-auto mb-8 text-base leading-[1.65]">
          The page you are looking for does not exist or has been moved.
        </p>

        <div class="flex justify-center gap-4">
          <Button href="/">Back to Home</Button>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>

<style>
  .fade-in {
    opacity: 0;
    animation: fadeIn var(--duration-fade) var(--ease-standard) forwards;
  }

  .delay-1 {
    animation-delay: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
