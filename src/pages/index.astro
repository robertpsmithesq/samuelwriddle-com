---
import Container from "../components/ui/Container.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout>
  <section id="hero" class="flex min-h-screen items-center px-4 py-20 md:px-8">
    <Container>
      <p class="mono text-secondary mb-4 text-sm">Placeholder content</p>
      <h1 class="gradient-text mb-6 text-5xl font-bold md:text-7xl">
        Sam Riddle
      </h1>
      <p class="text-secondary max-w-2xl text-lg leading-relaxed">
        Temporary homepage height while the real content sections are being
        built.
      </p>
    </Container>
  </section>

  <section class="min-h-screen px-4 py-20 md:px-8" aria-label="Coming soon">
    <Container>
      <div class="card rounded-xl p-6">
        <p class="text-secondary">
          More homepage content is coming in the next milestone.
        </p>
      </div>
    </Container>
  </section>
</PageLayout>
