---
import Container from "../ui/Container.astro";
---

<footer class="site-footer px-4 py-8 md:px-8">
  <Container class="flex flex-col items-center gap-3 text-center">
    <span class="site-footer-mark" aria-hidden="true"></span>

    <p class="site-footer-text text-sm">&copy; 2026 Sam Riddle.</p>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-soft);
  }

  .site-footer-mark {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    background-color: var(--color-accent);
    -webkit-mask: url("/favicon-red.svg") center / contain no-repeat;
    mask: url("/favicon-red.svg") center / contain no-repeat;
  }

  .site-footer-text {
    color: var(--color-text-tertiary);
  }
</style>
