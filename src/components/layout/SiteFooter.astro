---
import Container from "../ui/Container.astro";
---

<footer class="border-line-soft border-t px-4 py-8 md:px-8">
  <Container class="flex flex-col items-center gap-3 text-center">
    <span class="site-footer-mark bg-brand block h-6 w-6" aria-hidden="true"
    ></span>

    <p class="text-tertiary text-sm">&copy; 2026 Sam Riddle.</p>
  </Container>
</footer>

<style>
  .site-footer-mark {
    -webkit-mask: url("/favicon-red.svg") center / contain no-repeat;
    mask: url("/favicon-red.svg") center / contain no-repeat;
  }
</style>
