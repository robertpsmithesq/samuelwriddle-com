---
import Container from "../ui/Container.astro";
import MobileNav from "./MobileNav.astro";

const navItems = [
  { href: "/#about", label: "About" },
  { href: "/#experience", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#skills", label: "Skills" },
  { href: "/#strengths", label: "Strengths" },
  { href: "/#education", label: "Education" },
  { href: "/#contact", label: "Contact" },
];

const headerClasses =
  "sticky top-0 z-50 border-b border-line-soft bg-canvas-overlay px-4 py-4 backdrop-blur-panel md:px-8";
const navLinkClasses =
  "nav-link desktop-nav-link relative text-secondary transition-colors hover:text-brand";
---

<header class={headerClasses}>
  <Container>
    <nav
      class="flex items-center justify-between"
      aria-label="Primary navigation"
    >
      <a
        href="/"
        class="inline-flex items-center justify-center"
        aria-label="Sam Riddle home"
      >
        <span class="site-logo-mark bg-brand block h-8 w-8" aria-hidden="true"
        ></span>
      </a>

      <div class="hidden gap-6 text-sm md:flex">
        {
          navItems.map((item) => (
            <a href={item.href} class={navLinkClasses}>
              {item.label}
            </a>
          ))
        }
      </div>

      <MobileNav navItems={navItems} />
    </nav>
  </Container>
</header>

<style>
  .site-logo-mark {
    -webkit-mask: url("/favicon-red.svg") center / contain no-repeat;
    mask: url("/favicon-red.svg") center / contain no-repeat;
  }

  .desktop-nav-link::after {
    position: absolute;
    right: 50%;
    bottom: -0.375rem;
    left: 50%;
    height: 0.125rem;
    content: "";
    background-color: var(--color-accent);
    border-radius: 999px;
    transition:
      right var(--duration-fast) var(--ease-standard),
      left var(--duration-fast) var(--ease-standard);
  }

  .desktop-nav-link:hover::after,
  .desktop-nav-link.active::after {
    right: 0;
    left: 0;
  }

  .nav-link.active {
    color: var(--color-accent);
  }
</style>
