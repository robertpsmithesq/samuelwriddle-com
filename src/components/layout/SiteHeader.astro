---
import Container from "../ui/Container.astro";
import MobileNav from "./MobileNav.astro";

const navItems = [
  { href: "/#about", label: "About" },
  { href: "/#experience", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#skills", label: "Skills" },
  { href: "/#strengths", label: "Strengths" },
  { href: "/#education", label: "Education" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="sticky-nav px-4 py-4 md:px-8">
  <Container>
    <nav
      class="flex items-center justify-between"
      aria-label="Primary navigation"
    >
      <a href="/" class="site-logo" aria-label="Sam Riddle home">
        <span aria-hidden="true"></span>
      </a>

      <div class="hidden gap-6 text-sm md:flex">
        {
          navItems.map((item) => (
            <a href={item.href} class="nav-link desktop-nav-link">
              {item.label}
            </a>
          ))
        }
      </div>

      <MobileNav navItems={navItems} />
    </nav>
  </Container>
</header>

<style>
  .sticky-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-background-overlay);
    border-bottom: 1px solid var(--color-border-soft);
    backdrop-filter: blur(var(--blur-soft));
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .site-logo span {
    display: block;
    width: 2rem;
    height: 2rem;
    background-color: var(--color-accent);
    -webkit-mask: url("/favicon-red.svg") center / contain no-repeat;
    mask: url("/favicon-red.svg") center / contain no-repeat;
  }

  .nav-link {
    position: relative;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .desktop-nav-link::after {
    position: absolute;
    right: 50%;
    bottom: -0.375rem;
    left: 50%;
    height: 0.125rem;
    content: "";
    background-color: var(--color-accent);
    border-radius: 999px;
    transition:
      right var(--duration-fast) var(--ease-standard),
      left var(--duration-fast) var(--ease-standard);
  }

  .desktop-nav-link:hover::after,
  .desktop-nav-link.active::after {
    right: 0;
    left: 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }
</style>
