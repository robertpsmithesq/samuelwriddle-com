---
import Container from "../ui/Container.astro";

const links = [
  {
    label: "LinkedIn",
    description: "Professionally connect with me.",
    href: "https://www.linkedin.com/in/samuel-w-riddle",
  },
  {
    label: "GitHub",
    description: "Proof that I'm actually building things.",
    href: "https://github.com/riddlemeS4m",
  },
];

const linkClasses =
  "online-link group relative grid min-h-28 grid-cols-[1fr_auto] items-center gap-4 overflow-hidden rounded-xl border border-line-soft p-4 px-[1.125rem] text-inherit no-underline transition hover:-translate-y-0.75 hover:border-brand-strong hover:shadow-[0_18px_48px_rgb(0_0_0_/_0.18)] focus-visible:-translate-y-0.75 focus-visible:border-brand-strong focus-visible:outline-none focus-visible:shadow-[var(--focus-ring-accent),0_18px_48px_rgb(0_0_0_/_0.18)] sm:min-h-[7.75rem]";
const linkCopyClasses = "grid min-w-0 gap-2 pr-3 pb-3.5";
const arrowClasses =
  "grid h-9 w-9 translate-x-[-0.375rem] place-items-center self-center justify-self-end rounded-full border border-brand-medium bg-brand-soft text-primary opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100";
---

<section id="contact" class="px-4 py-20 md:px-8">
  <Container class="max-w-6xl">
    <div class="mx-auto w-full md:w-[60vw] md:max-w-full">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <p class="text-secondary mb-6 text-lg leading-[1.7] italic sm:mb-8">
          Want to see what I'm building or get in touch?
        </p>
        <h2 class="text-3xl font-bold">
          Find Me <span class="text-brand">Online</span>
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClasses}
              aria-label={`${link.label}: ${link.description} Opens in a new tab.`}
            >
              <span class={linkCopyClasses}>
                <span class="text-primary text-lg leading-tight font-bold">
                  {link.label}
                </span>
                <span class="text-secondary leading-[1.55]">
                  {link.description}
                </span>
              </span>

              <span class={arrowClasses} aria-hidden="true">
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .online-link {
    background:
      linear-gradient(
        135deg,
        rgb(var(--color-accent-rgb) / 0.12),
        transparent 34%
      ),
      linear-gradient(180deg, var(--color-surface-soft), transparent),
      var(--color-background);
  }

  .online-link::after {
    position: absolute;
    right: 1.125rem;
    bottom: 1rem;
    left: 1.125rem;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, var(--color-accent), transparent 72%);
    opacity: 0.45;
    transform: scaleX(0.42);
    transform-origin: left;
    transition: var(--transition-base);
  }

  .online-link:hover::after,
  .online-link:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }
</style>
