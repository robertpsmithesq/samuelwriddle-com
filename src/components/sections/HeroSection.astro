---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section id="hero" class="flex min-h-screen items-center px-4 py-20 md:px-8">
  <Container>
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="mono text-secondary mb-4 text-sm">Hi! My name is</p>
        <h1 class="gradient-text mb-6 text-5xl font-bold md:text-7xl">
          Sam Riddle
        </h1>
        <h2 class="text-secondary mb-8 text-2xl md:text-3xl">
          Software Engineer @ QuantHub
        </h2>
        <p class="text-secondary mb-12 max-w-2xl text-lg leading-relaxed">
          I'm building software to close the gap between how people learn skills
          and how those skills are taught. I'm exploring the systems, feedback
          loops, and everyday practices that help people improve.
        </p>
        <div class="flex gap-4">
          <Button href="#projects">View My Work</Button>
          <Button href="#contact" variant="secondary">Contact</Button>
        </div>
      </div>

      <div class="hero-mark" aria-hidden="true"></div>
    </div>
  </Container>
</section>

<style>
  .hero-layout {
    display: grid;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-mark {
    display: none;
    width: min(34vw, 24rem);
    aspect-ratio: 1;
    justify-self: end;
    background:
      radial-gradient(
        circle,
        rgb(var(--color-accent-rgb) / 0.18),
        transparent 68%
      ),
      var(--color-accent);
    -webkit-mask: url("/favicon-red.svg") center / contain no-repeat;
    mask: url("/favicon-red.svg") center / contain no-repeat;
    opacity: 0.9;
    filter: drop-shadow(0 2rem 4rem rgb(var(--color-accent-rgb) / 0.18));
  }

  @media (min-width: 768px) {
    .hero-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.65fr);
      gap: 4rem;
    }

    .hero-mark {
      display: block;
    }
  }
</style>
