---
import Container from "../ui/Container.astro";

const strengths = ["Learner", "Focus", "Achiever", "Analytical", "Relator"];

const strengthsListClasses =
  "strengths-list mx-auto w-full max-w-xs space-y-5 rounded-2xl border border-line-soft p-6 md:col-span-2 md:mx-0 md:self-center md:justify-self-center";
---

<section id="strengths" class="px-4 py-20 md:px-8">
  <Container>
    <h2 class="mb-12 text-3xl font-bold">
      My <span class="text-brand">Strengths</span>
    </h2>

    <div class="grid gap-10 md:grid-cols-5 md:gap-16">
      <ol class={strengthsListClasses} aria-label="CliftonStrengths themes">
        {
          strengths.map((strength, index) => (
            <li class="border-line-soft flex items-center gap-4 border-b pb-5 last:border-b-0 last:pb-0">
              <span class="text-brand font-mono text-sm">
                {(index + 1).toString().padStart(2, "0")}
              </span>
              <span class="text-primary text-xl font-semibold">{strength}</span>
            </li>
          ))
        }
      </ol>

      <div
        class="text-secondary space-y-6 text-lg leading-relaxed md:col-span-3"
      >
        <p>
          I work best when I have space to understand a problem before rushing
          to solve it. I like to ask good questions, narrow the scope, inspect
          the evidence, and make steady progress while building trust with
          everyone involved.
        </p>

        <p>
          Learner and Analytical help me understand things. Focus and Achiever
          help me turn that understanding into high-quality work. Relator keeps
          that work focused on actually helping people, because the best
          solutions depend on people trusting each other to be honest,
          thoughtful, and reliable.
        </p>

        <p>
          In practice, that means I care about clear communication, project
          momentum, and personal context. I like making ambiguous problems feel
          workable without pretending they're simpler than they actually are.
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  .strengths-list {
    background:
      linear-gradient(
        135deg,
        rgb(var(--color-accent-rgb) / 0.12),
        transparent 42%
      ),
      linear-gradient(180deg, var(--color-surface-soft), transparent),
      var(--color-background);
    background-clip: padding-box;
  }
</style>
