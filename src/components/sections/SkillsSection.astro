---
import Container from "../ui/Container.astro";

const skillMappings = [
  {
    skill: "Critical Thinking",
    output:
      "I break complex problems into practical pieces, and I simplify them to real-world examples.",
    prompt: "Ask me about my hackathon win.",
  },
  {
    skill: "Process Design",
    output:
      "I separate vague workflows into clear stages, and I'm aware of bottlenecks.",
    prompt: "Ask me about my budgeting app.",
  },
  {
    skill: "Domain Modeling",
    output:
      "I know where responsibilities belong, and I'm tough on scope creep.",
    prompt: "Ask me about my ViewComponent design patterns.",
  },
  {
    skill: "Planning & Execution",
    output:
      "I bring structure to open-ended projects, and I deliver high-quality results.",
    prompt: "Ask me about mock interviews.",
  },
  {
    skill: "Stakeholder Relationships",
    output:
      "I build trust with clear communication, and I enjoy assisting my teammates.",
    prompt: "Ask me about doing code reviews as a junior.",
  },
];
---

<section id="skills" class="px-4 py-20 md:px-8">
  <Container>
    <div class="mb-12 max-w-2xl">
      <h2 class="text-3xl font-bold">
        My <span class="accent-red">Skills</span>
      </h2>
    </div>

    <div class="skills-map" aria-label="Skills mapped to outcomes">
      {
        skillMappings.map((skill) => (
          <article class="skills-map-row">
            <div class="skills-map-skill">
              <h3>{skill.skill}</h3>
            </div>

            <div class="skills-map-output">
              <p class="skills-map-output-text">{skill.output}</p>
              <p class="skills-map-output-prompt">{skill.prompt}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .skills-map {
    display: grid;
    gap: 1.75rem;
    width: 100%;
    margin: 0 auto;
  }

  .skills-map-row {
    position: relative;
    display: grid;
    gap: 0.875rem;
    align-items: center;
    padding: 1.5rem;
    text-align: center;
    background:
      linear-gradient(
        135deg,
        rgb(var(--color-accent-rgb) / 0.12),
        transparent 42%
      ),
      linear-gradient(180deg, var(--color-surface-soft), transparent),
      var(--color-background);
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
  }

  .skills-map-row:last-child {
    padding-bottom: 1.5rem;
  }

  .skills-map-skill h3 {
    position: relative;
    display: inline-block;
    margin: 0;
    padding-bottom: 0.55rem;
    color: var(--color-text-primary);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }

  .skills-map-skill h3::after {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(7rem, 78%);
    height: 1px;
    content: "";
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    opacity: 0.8;
    transform: translateX(-50%);
    box-shadow: 0 0 12px rgb(var(--color-accent-rgb) / 0.34);
  }

  .skills-map-output-text {
    max-width: 34rem;
    margin: 0 auto;
    font-size: 1.125rem;
    line-height: 1.625;
    text-align: center;
    text-wrap: balance;
  }

  .skills-map-output-prompt {
    max-width: 34rem;
    margin: 0.35rem auto 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .skills-map {
      gap: 1.25rem;
      width: 60vw;
      max-width: 100%;
    }

    .skills-map-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
      padding: 1.75rem 2rem;
      text-align: left;
    }

    .skills-map-skill {
      text-align: center;
    }

    .skills-map-output-text,
    .skills-map-output-prompt {
      text-align: center;
    }
  }
</style>
