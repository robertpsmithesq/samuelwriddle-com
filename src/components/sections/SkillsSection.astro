---
import Container from "../ui/Container.astro";

const skillMappings = [
  {
    skill: "Critical Thinking",
    output:
      "I break complex problems into practical pieces, and I simplify them to real-world examples.",
    prompt: "Ask me about my hackathon win.",
  },
  {
    skill: "Process Development",
    output:
      "I separate vague workflows into clear stages, and I'm aware of bottlenecks.",
    prompt: "Ask me about my budgeting app.",
  },
  {
    skill: "Domain Modeling",
    output:
      "I know where responsibilities belong, and I'm tough on scope creep.",
    prompt: "Ask me about my ViewComponent design patterns.",
  },
  {
    skill: "Planning & Execution",
    output:
      "I bring structure to open-ended projects, and I deliver high-quality results.",
    prompt: "Ask me about mock interviews.",
  },
  {
    skill: "Stakeholder Relationships",
    output:
      "I build trust with clear communication, and I enjoy assisting my teammates.",
    prompt: "Ask me about doing code reviews as a junior.",
  },
];

const mapClasses = "skills-map-grid mx-auto grid w-full gap-5 sm:grid-cols-2";
const rowClasses =
  "skills-map-row relative grid items-start gap-5 rounded-2xl border border-line-soft px-6 py-10 text-center sm:min-h-full sm:px-7 sm:py-12 min-[1000px]:grid-rows-[4.25rem_1fr] min-[1000px]:px-5 min-[1000px]:py-12";
const headingWrapClasses =
  "flex min-h-[4.25rem] items-end justify-center text-center min-[1000px]:min-h-0";
const headingClasses =
  "relative m-0 inline-block pb-[0.55rem] text-xl leading-[1.15] font-bold text-primary [text-wrap:balance]";
const outputTextClasses =
  "mx-auto max-w-[34rem] text-center text-base leading-[1.6] [text-wrap:balance]";
const outputPromptClasses =
  "mx-auto mt-[0.35rem] max-w-[34rem] text-center text-[0.95rem] leading-[1.45] text-secondary italic [text-wrap:balance]";
---

<section id="skills" class="px-4 py-20 md:px-8">
  <Container>
    <div class="mb-12 max-w-2xl">
      <h2 class="text-3xl font-bold">
        My <span class="text-brand">Skills</span>
      </h2>
    </div>

    <div class={mapClasses} aria-label="Skills mapped to outcomes">
      {
        skillMappings.map((skill) => (
          <article class={rowClasses}>
            <div class={headingWrapClasses}>
              <h3 class={headingClasses}>{skill.skill}</h3>
            </div>

            <div>
              <p class={outputTextClasses}>{skill.output}</p>
              <p class={outputPromptClasses}>{skill.prompt}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  @media (min-width: 1000px) {
    .skills-map-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .skills-map-row {
    background:
      linear-gradient(
        135deg,
        rgb(var(--color-accent-rgb) / 0.12),
        transparent 42%
      ),
      linear-gradient(180deg, var(--color-surface-soft), transparent),
      var(--color-background);
    background-clip: padding-box;
  }

  h3::after {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(7rem, 78%);
    height: 1px;
    content: "";
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    opacity: 0.8;
    transform: translateX(-50%);
    box-shadow: 0 0 12px rgb(var(--color-accent-rgb) / 0.34);
  }
</style>
