---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  type = "button",
  class: className,
  ...attrs
} = Astro.props;

const variantClasses = {
  primary: "bg-brand text-white transition hover:bg-brand-dark",
  secondary:
    "border border-line-strong bg-transparent text-primary transition hover:border-primary hover:bg-surface hover:text-primary",
};

const classes = [
  "inline-flex items-center justify-center rounded-lg px-6 py-3 font-medium",
  variantClasses[variant],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...attrs}>
      <slot />
    </button>
  )
}
