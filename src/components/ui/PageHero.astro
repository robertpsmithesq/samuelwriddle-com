---
import Container from "./Container.astro";

interface Props {
  id?: string;
  caption: string;
  title: string;
  subtitle?: string;
  description?: string;
  class?: string;
  showMark?: boolean;
}

const {
  id,
  caption,
  title,
  subtitle,
  description,
  class: className,
  showMark = true,
} = Astro.props;

const hasActions = Astro.slots.has("actions");
---

<section
  id={id}
  class:list={["flex min-h-screen items-center px-4 py-20 md:px-8", className]}
>
  <Container>
    <div
      class="grid items-center md:grid-cols-[minmax(0,1.35fr)_minmax(14rem,0.65fr)] md:gap-16"
    >
      <div class="min-w-0">
        <p class="text-secondary mb-4 font-mono text-sm">{caption}</p>
        <h1
          class="gradient-text mb-6 pb-1 text-5xl leading-[1.08] font-bold md:text-7xl"
        >
          {title}
        </h1>
        {
          subtitle && (
            <h2 class="text-secondary mb-8 text-2xl md:text-3xl">{subtitle}</h2>
          )
        }
        {
          description && (
            <p class="text-secondary mb-12 max-w-2xl text-lg leading-relaxed">
              {description}
            </p>
          )
        }
        {
          hasActions && (
            <div class="flex gap-4">
              <slot name="actions" />
            </div>
          )
        }
      </div>

      {showMark && <div class="hero-mark" aria-hidden="true" />}
    </div>
  </Container>
</section>

<style>
  .gradient-text {
    background: linear-gradient(
      135deg,
      var(--color-accent-light),
      var(--color-accent),
      var(--color-accent-dark)
    );
    background-size: 200% 200%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift var(--duration-gradient) var(--ease-standard)
      infinite;
  }

  .hero-mark {
    display: none;
    width: min(34vw, 24rem);
    aspect-ratio: 1;
    justify-self: end;
    background:
      radial-gradient(
        circle,
        rgb(var(--color-accent-rgb) / 0.18),
        transparent 68%
      ),
      var(--color-accent);
    -webkit-mask: url("/favicon-red.svg") center / contain no-repeat;
    mask: url("/favicon-red.svg") center / contain no-repeat;
    opacity: 0.9;
    filter: drop-shadow(0 2rem 4rem rgb(var(--color-accent-rgb) / 0.18));
  }

  @media (min-width: 768px) {
    .hero-mark {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gradient-text {
      animation: none;
    }
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }
  }
</style>
