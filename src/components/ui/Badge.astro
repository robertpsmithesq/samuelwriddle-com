---
interface Props {
  class?: string;
  interactive?: boolean;
  solid?: boolean;
}

const { class: className, interactive = false, solid = false } = Astro.props;
---

<span
  class:list={[
    "border-line-medium bg-line-soft text-primary rounded-lg border px-3 py-1 text-sm transition",
    {
      "bg-badge-solid": solid,
      "hover:border-brand hover:text-brand hover:-translate-y-px": interactive,
    },
    className,
  ]}
>
  <slot />
</span>
