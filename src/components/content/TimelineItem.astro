---
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";

interface Props {
  title: string;
  dateLabel: string;
  company: string;
  location: string;
  highlights: string[];
  skills: string[];
  isCurrent?: boolean;
}

const {
  title,
  dateLabel,
  company,
  location,
  highlights,
  skills,
  isCurrent = false,
} = Astro.props;

const dotClasses = [
  "absolute top-8 left-1 grid h-4 w-4 place-items-center rounded-full border bg-canvas md:left-6",
  isCurrent
    ? "border-brand shadow-timeline-dot-current"
    : "border-brand-strong shadow-timeline-dot",
];
---

<article class="relative pl-10 md:pl-20">
  <div class:list={dotClasses} aria-hidden="true">
    <span class="bg-brand shadow-timeline-dot-inner h-1.5 w-1.5 rounded-full"
    ></span>
  </div>

  <Card class="relative" highlighted={isCurrent}>
    <header
      class="mb-2 flex flex-col gap-2 md:flex-row md:items-start md:justify-between"
    >
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="text-xl font-semibold">{title}</h3>
        {
          isCurrent && (
            <span class="border-brand-strong bg-brand-soft text-brand rounded-full border px-2.5 py-1 font-mono text-xs">
              Current
            </span>
          )
        }
      </div>
      <span class="text-secondary text-sm">{dateLabel}</span>
    </header>

    <p class="mb-3">{company} | {location}</p>

    <ul class="impact-list text-secondary space-y-2">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>

    <div class="mt-4 flex flex-wrap gap-2">
      {skills.map((skill) => <Badge class="rounded text-xs">{skill}</Badge>)}
    </div>
  </Card>
</article>

<style>
  .impact-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .impact-list li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.5rem;
    height: 1px;
    content: "";
    background: var(--color-text-primary);
    box-shadow: 0 0 10px rgb(239 68 68 / 45%);
  }
</style>
