---
interface Props {
  name: string;
  tag: string;
  href: string;
  image?: string;
}

const { name, tag, href, image } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="project-card card card--interactive"
  aria-label={`Open ${name}`}
>
  <div class="project-card-preview" aria-hidden="true">
    {image ? <img src={image} alt="" loading="lazy" /> : <span>{name}</span>}
  </div>
  <div class="project-card-caption">
    <p>{name}</p>
    <p>{tag}</p>
  </div>
</a>

<style>
  .card {
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border-soft);
    backdrop-filter: blur(var(--blur-soft));
    transition: var(--transition-base);
  }

  .card--interactive:hover {
    border-color: var(--color-accent-strong);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .project-card {
    display: block;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    border-radius: 1rem;
  }

  .project-card-preview {
    display: grid;
    width: 100%;
    box-sizing: border-box;
    aspect-ratio: 16 / 10;
    min-height: 18rem;
    padding: 2rem;
    overflow: hidden;
    place-items: center;
    background:
      linear-gradient(135deg, rgb(239 68 68 / 12%), transparent 42%),
      linear-gradient(180deg, var(--color-surface-soft), transparent),
      var(--color-background);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .project-card-preview span {
    display: block;
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--color-text-secondary);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
    opacity: 0.88;
  }

  .project-card-preview img {
    display: block;
    width: min(100%, 28rem);
    max-height: 100%;
    height: auto;
    object-fit: contain;
  }

  .project-card-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.25rem;
  }

  .project-card-caption p:first-child {
    font-weight: 700;
  }

  .project-card-caption p:last-child {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
</style>
